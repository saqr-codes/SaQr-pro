  "guide": [
    {
      "id": "fund",
      "title": {
        "ar": "أساسيات",
        "en": "Fundamentals"
      },
      "items": [
        {
          "t": {
            "ar": "اتحرك دايماً",
            "en": "Keep moving"
          },
          "d": {
            "ar": "الواقف بيتضرب بسهولة. اتحرك يمين وشمال بين كل رشقة، ومتجريش في خط مستقيم.",
            "en": "A standing target is easy to hit. Strafe between bursts and never run in a straight line."
          }
        },
        {
          "t": {
            "ar": "مستوى الكروس",
            "en": "Crosshair height"
          },
          "d": {
            "ar": "خلّي الكروس دايماً على مستوى الراس وانت بتتحرك، فتوفّر وقت التصويب.",
            "en": "Keep the crosshair at head height while moving so you save aiming time."
          }
        },
        {
          "t": {
            "ar": "البيك الآمن",
            "en": "Safe peeking"
          },
          "d": {
            "ar": "بيك سريع من الحافة ورجوع، بدل ما تقف مكشوف تبادل ضرب.",
            "en": "Peek quickly from the edge and return instead of standing exposed in a trade."
          }
        },
        {
          "t": {
            "ar": "حائط الجلو",
            "en": "Gloo wall"
          },
          "d": {
            "ar": "ارمي الحائط قبل ما تعالج أو تعيد تحميل، مش بعد ما تتضرب.",
            "en": "Place the wall before you heal or reload, not after you are hit."
          }
        },
        {
          "t": {
            "ar": "العلاج",
            "en": "Healing"
          },
          "d": {
            "ar": "اعالج وانت مستخبي، وما تقفش في الزون تعالج.",
            "en": "Heal while hidden and never stand in the open to heal."
          }
        }
      ]
    },
    {
      "id": "rank",
      "title": {
        "ar": "رانكد",
        "en": "Ranked"
      },
      "items": [
        {
          "t": {
            "ar": "حسابات النقاط",
            "en": "Points balance"
          },
          "d": {
            "ar": "في الرانكد المركز بيفرق قد الكيلز تقريباً. لعب هادي وصح أحسن من نزول خطر.",
            "en": "In ranked, placement matters about as much as kills. Calm, smart play beats risky drops."
          }
        },
        {
          "t": {
            "ar": "التواصل",
            "en": "Comms"
          },
          "d": {
            "ar": "اتفقوا على مكان النزول والدور قبل البداية، واستخدموا البنج مش الكلام الكتير.",
            "en": "Agree on the drop spot and roles before the start; use pings instead of long talk."
          }
        },
        {
          "t": {
            "ar": "الزون",
            "en": "Zone"
          },
          "d": {
            "ar": "اتحرك للزون بدري واختار مكان فيه غطا، ومتسيبش نفسك تتعلّق في الدايرة الأخيرة.",
            "en": "Rotate early to a spot with cover and do not get caught on the edge of the final circle."
          }
        },
        {
          "t": {
            "ar": "الهدوء بعد الكيل",
            "en": "After a kill"
          },
          "d": {
            "ar": "بعد أي كيل، غيّر مكانك بدل ما تسرق اللوت وتقف مكشوف.",
            "en": "After a kill, reposition instead of looting in the open."
          }
        }
      ]
    },
    {
      "id": "maps",
      "title": {
        "ar": "الخرائط",
        "en": "Maps"
      },
      "items": [
        {
          "t": {
            "ar": "قواعد عامة للخرايط",
            "en": "General map rules"
          },
          "d": {
            "ar": "المناطق الوسطية مليانة فرق، والأطراف أهدى ومكسبها لوت أقل. اختار نزولك على قد مستوى فريقك.",
            "en": "Central zones are crowded; edges are calmer with less loot. Choose your drop to match your squad's level."
          }
        },
        {
          "t": {
            "ar": "الأرض العالية",
            "en": "High ground"
          },
          "d": {
            "ar": "في أي خريطة، الأرض العالية بتدي رؤية وتحكم، بس بتكشفك. اتحرك بين الأسطح بحذر.",
            "en": "On any map high ground gives vision and control but exposes you. Move between rooftops carefully."
          }
        },
        {
          "t": {
            "ar": "الكباري والمضايق",
            "en": "Bridges and chokepoints"
          },
          "d": {
            "ar": "الكباري والمعابر الضيقة أماكن كمين. اعبرها بسرعة أو اتفادى بدائل.",
            "en": "Bridges and narrow crossings are ambush spots. Cross quickly or pick another route."
          }
        },
        {
          "t": {
            "ar": "الصحراء والمساحات المفتوحة",
            "en": "Open desert areas"
          },
          "d": {
            "ar": "المساحات المفتوحة بتحتاج سكوب وقناص وحائط جلو. متعدّيهاش من غير غطا.",
            "en": "Open areas favor scopes and snipers. Never cross them without cover."
          }
        },
        {
          "t": {
            "ar": "المباني القريبة",
            "en": "Close quarters"
          },
          "d": {
            "ar": "في المباني القريبة سلاح قصير المدى وحركة سريعة. اقفل الأبواب والسلالم.",
            "en": "In close quarters use short-range weapons and fast movement. Control doors and stairs."
          }
        }
      ]
    },
    {
      "id": "weap",
      "title": {
        "ar": "الأسلحة",
        "en": "Weapons"
      },
      "items": [
        {
          "t": {
            "ar": "قريب: شوتجن وSMG",
            "en": "Close: shotgun and SMG"
          },
          "d": {
            "ar": "للمواجهات القريبة. شوتجن للدفعة الواحدة وSMG للتتبع السريع.",
            "en": "For close fights: shotgun for a single burst, SMG for fast tracking."
          }
        },
        {
          "t": {
            "ar": "متوسط: AR",
            "en": "Mid: AR"
          },
          "d": {
            "ar": "الأنسب للأغلب. اتحكم في الارتداد بسحب خفيف لتحت.",
            "en": "Best all-rounder. Control recoil with a light pull downward."
          }
        },
        {
          "t": {
            "ar": "بعيد: قناص",
            "en": "Far: sniper"
          },
          "d": {
            "ar": "اتنفس قبل الضربة، وغيّر مكانك بعد كل طلقة.",
            "en": "Settle before the shot and change position after each one."
          }
        },
        {
          "t": {
            "ar": "التبديل",
            "en": "Switching"
          },
          "d": {
            "ar": "جرّب كذا سلاح في التدريب. اللي تتحكم فيه أحسن من اللي بيقولوا عليه قوي.",
            "en": "Try several weapons in training. The one you control beats the one called strong."
          }
        }
      ]
    },
    {
      "id": "squad",
      "title": {
        "ar": "الفريق",
        "en": "Squad"
      },
      "items": [
        {
          "t": {
            "ar": "حدّدوا أدوار",
            "en": "Set roles"
          },
          "d": {
            "ar": "واحد قائد بيدي الكول، واحد قناص، واحد دعم بيعالج. الفريق اللي كل واحد فيه عارف دوره بيكسب أكتر.",
            "en": "One leader making calls, one sniper, one support who heals. A squad where everyone knows their role wins more."
          }
        },
        {
          "t": {
            "ar": "البنج مش الكلام",
            "en": "Ping, do not talk"
          },
          "d": {
            "ar": "استخدم البنج للعدو والمكان واللوت. الكلام الكتير بيغطي على الصوت المهم.",
            "en": "Use pings for enemies, positions and loot. Too much talk hides important sounds."
          }
        },
        {
          "t": {
            "ar": "ما تفترقوش",
            "en": "Stay close"
          },
          "d": {
            "ar": "ابقوا قريبين من بعض بحيث تقدروا تنعشوا بعض بسرعة. اللي بيبعد لوحده بيتقفل عليه.",
            "en": "Stay close enough to revive each other fast. A lone player gets picked off."
          }
        },
        {
          "t": {
            "ar": "ركّزوا على واحد",
            "en": "Focus one target"
          },
          "d": {
            "ar": "ضربوا نفس العدو مع بعض بدل ما كل واحد يضرب واحد. بيموت أسرع.",
            "en": "Shoot the same enemy together instead of one each. He goes down faster."
          }
        },
        {
          "t": {
            "ar": "الإنعاش",
            "en": "Reviving"
          },
          "d": {
            "ar": "ما تنعشش وانت مكشوف. حط حائط جلو الأول وبعدين ابدأ.",
            "en": "Do not revive in the open. Place a gloo wall first, then start."
          }
        }
      ]
    },
    {
      "id": "sound",
      "title": {
        "ar": "الصوت",
        "en": "Audio"
      },
      "items": [
        {
          "t": {
            "ar": "سماعة كويسة",
            "en": "Good headphones"
          },
          "d": {
            "ar": "الخطوات واتجاه الطلقات بتتسمع بوضوح في السماعة. ده أرخص تحسين للمستوى.",
            "en": "Footsteps and shot direction are much clearer on headphones. It is the cheapest upgrade."
          }
        },
        {
          "t": {
            "ar": "قلل الموسيقى",
            "en": "Lower music"
          },
          "d": {
            "ar": "اقفل موسيقى اللعبة أو قلّلها وخلّي المؤثرات أعلى.",
            "en": "Turn the game music down or off and keep sound effects higher."
          }
        },
        {
          "t": {
            "ar": "اسمع قبل ما تتحرك",
            "en": "Listen first"
          },
          "d": {
            "ar": "قبل ما تدخل مبنى، وقّف ثانيتين واسمع: خطوات وفتح أبواب وإعادة تحميل.",
            "en": "Before entering a building, pause two seconds and listen for steps, doors and reloads."
          }
        },
        {
          "t": {
            "ar": "لا تتكلم والعدو قريب",
            "en": "Stay quiet near enemies"
          },
          "d": {
            "ar": "ميكروفونك ممكن يوصّل صوتك للأعداء القريبين لو في نفس المنطقة.",
            "en": "Your mic may let nearby enemies hear you if they are close."
          }
        }
      ]
    },
    {
      "id": "mind",
      "title": {
        "ar": "التركيز",
        "en": "Mindset"
      },
      "items": [
        {
          "t": {
            "ar": "استراحة كل 45 دقيقة",
            "en": "Break every 45 min"
          },
          "d": {
            "ar": "التعب بيقلل التركيز وبيزود الأخطاء. استراحة قصيرة بترجعك أحسن.",
            "en": "Fatigue lowers focus and raises mistakes. A short break brings you back sharper."
          }
        },
        {
          "t": {
            "ar": "متلعبش وانت متعصب",
            "en": "Do not play tilted"
          },
          "d": {
            "ar": "لو خسرت مباراتين ورا بعض بعصبية، وقّف شوية. القرارات بتبقى أسوأ.",
            "en": "If you lost two matches in a row angrily, stop for a bit. Decisions get worse."
          }
        },
        {
          "t": {
            "ar": "حلل الخسارة",
            "en": "Review losses"
          },
          "d": {
            "ar": "اسأل نفسك: ماتّ إزاي؟ مكشوف؟ مفيش غطا؟ استعجلت؟ الإجابة هي اللي تغيّرها.",
            "en": "Ask yourself how you died: exposed, no cover, rushed? The answer is what to change."
          }
        },
        {
          "t": {
            "ar": "هدف صغير لكل جلسة",
            "en": "One small goal per session"
          },
          "d": {
            "ar": "مثلاً: ما أقفش مكشوف أبداً. هدف واحد أحسن من عشرة.",
            "en": "For example: never stand exposed. One goal beats ten."
          }
        }
      ]
    },
    {
      "id": "ingame",
      "title": {
        "ar": "إعدادات اللعبة",
        "en": "In-game settings"
      },
      "items": [
        {
          "t": {
            "ar": "زر النار",
            "en": "Fire button"
          },
          "d": {
            "ar": "جرّب حجم زر النار من الإعدادات بالمدى المقترح في التطبيق، وحط زر ثاني على الجنب لو بتلعب بـ3 صوابع أو أكتر.",
            "en": "Try the fire button size suggested in the app and add a second button on the side if you play with three or more fingers."
          }
        },
        {
          "t": {
            "ar": "التقاط تلقائي",
            "en": "Auto pickup"
          },
          "d": {
            "ar": "شغّل الالتقاط التلقائي للعناصر المهمة بس عشان ما تتبعترش اللوت.",
            "en": "Enable auto pickup for important items only so your loot stays clean."
          }
        },
        {
          "t": {
            "ar": "سيب الجايرو مقفول أول",
            "en": "Gyro off at first"
          },
          "d": {
            "ar": "ما تفعّلهوش قبل ما تتعود على الحساسية العادية.",
            "en": "Do not enable gyro before you are comfortable with normal sensitivity."
          }
        },
        {
          "t": {
            "ar": "ثبّت الـ HUD",
            "en": "Keep your HUD fixed"
          },
          "d": {
            "ar": "غيّر مكان الأزرار مرة واحدة وسيبه. تغيير كل يوم بيوقّف التعوّد.",
            "en": "Set your button layout once and keep it. Changing daily stops muscle memory."
          }
        }
      ]
    },
    {
      "id": "loot",
      "title": {
        "ar": "اللوت",
        "en": "Loot"
      },
      "items": [
        {
          "t": {
            "ar": "خد الأساسيات",
            "en": "Take the essentials"
          },
          "d": {
            "ar": "درع، علاج، ذخيرة لسلاحك، وجرانيدات. الباقي حسب المساحة.",
            "en": "Armor, healing, ammo for your weapon, and grenades. The rest depends on space."
          }
        },
        {
          "t": {
            "ar": "سلاح واحد تتحكم فيه",
            "en": "One weapon you control"
          },
          "d": {
            "ar": "اتدرب على سلاحين كحد أقصى بدل ما تبدّل كل مباراة.",
            "en": "Train two weapons at most instead of switching every match."
          }
        },
        {
          "t": {
            "ar": "لوت الأعداء",
            "en": "Enemy drops"
          },
          "d": {
            "ar": "صندوق اللي مات بيجذب الفرق. اتأكد إن مفيش حد قريب قبل ما تقرّب.",
            "en": "A defeated player's box attracts squads. Check nobody is close before approaching."
          }
        },
        {
          "t": {
            "ar": "الجرانيدات",
            "en": "Grenades"
          },
          "d": {
            "ar": "استخدمها عشان تطلّع العدو من مخبأه، مش بس للضرر.",
            "en": "Use them to force enemies out of cover, not just for damage."
          }
        }
      ]
    }
  ],
  "notes": [
    {
      "ar": "الحساسية نقطة بداية مش رقم مضمون. كل إيد وكل موبايل مختلف، فاستخدم المعايرة وتمرين التصويب عشان توصل لرقمك.",
      "en": "Sensitivity is a starting point, not a guaranteed number. Every hand and phone is different, so use calibration and the aim drill to find yours."
    },
    {
      "ar": "على شاشات 120Hz وأعلى بنقلّل الحساسية 6.5% تلقائياً.",
      "en": "On 120Hz+ screens the app lowers sensitivity by 6.5% automatically."
    },
    {
      "ar": "غيّر القيم على خطوات 5 لـ 10 نقاط وجرّب في التدريب بين كل خطوة.",
      "en": "Change values in steps of 5 to 10 points and test in training between steps."
    },
    {
      "ar": "متغيّرش DPI الموبايل إلا لو فاهم تأثيره. مش لازم لتصويب كويس.",
      "en": "Do not change phone DPI unless you understand the effect. It is not needed for good aim."
    },
    {
      "ar": "الموبايلات الضعيفة (2 لـ 3GB): رسومات Smooth وفريمات عالية لو الجهاز مستحمل. لو سخن أو قطّع نزّل الإعدادات. خلّي الجايرو مقفول أول ما تبدأ.",
      "en": "Low-end phones (2 to 3GB): Smooth graphics with high FPS if the phone can take it. Lower settings if it overheats or stutters. Start with gyro off."
    },
    {
      "ar": "لو لسه جديد خلّي Aim Assist شغّال.",
      "en": "If you are new, keep Aim Assist on."
    }
  ],
