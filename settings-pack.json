  "tips": [
    {
      "ar": "سخّن إيدك 3 دقايق في التدريب قبل أي رانكد: تصويب وتتبع وبعدين ريأكشن.",
      "en": "Warm up 3 minutes in training before any ranked match: aim, tracking, then reaction."
    },
    {
      "ar": "غيّر حساسية واحدة بس في المرة وجرّب 10 دقايق قبل ما تحكم عليها.",
      "en": "Change one sensitivity at a time and test it for 10 minutes before judging."
    },
    {
      "ar": "سماعة كويسة بتفرق: خطوات العدو بتتسمع قبل ما تشوفه.",
      "en": "Good headphones matter: you hear footsteps before you see the enemy."
    },
    {
      "ar": "نزّل أول واحد وبعدين اتحرك. اتحرك دايماً بين كل تبادل ضرب.",
      "en": "Never stand still while trading shots. Keep moving between bursts."
    },
    {
      "ar": "اللعب في الزون: خد مكانك بدري وسيب عدوك هو اللي يتحرك.",
      "en": "Take your zone position early and let the enemy be the one who has to move."
    },
    {
      "ar": "ما تتركّزش على نفس الجرّة طول الوقت: اعمل بريك كل 45 دقيقة.",
      "en": "Do not grind nonstop: take a break every 45 minutes."
    },
    {
      "ar": "الموبايل السخن بيقلل الفريمات: شيله من الشاحن واشيل الكفر.",
      "en": "A hot phone drops frames: unplug the charger and remove the case."
    },
    {
      "ar": "اختبر البنج قبل الرانكد. لو فوق 80ms جرّب شبكة تانية أو سيرفر أقرب.",
      "en": "Test your ping before ranked. If it is above 80ms try another network."
    },
    {
      "ar": "سجّل مبارياتك الخسرانة وراجعها: الأخطاء المتكررة هي أسرع طريق للتحسن.",
      "en": "Record and review lost matches: repeated mistakes are the fastest way to improve."
    },
    {
      "ar": "اتفق مع الفريق على الكول والمكان قبل النزول، مش بعده.",
      "en": "Agree with your squad on the drop spot and calls before dropping, not after."
    },
    {
      "ar": "إيدك بتتعب: مدّ صوابعك وريّحها بين المباريات.",
      "en": "Your hands tire: stretch your fingers between matches."
    },
    {
      "ar": "نضّف شاشة الموبايل قبل اللعب، السحب بيبقى أنعم.",
      "en": "Wipe the screen before playing; swipes feel smoother."
    },
    {
      "ar": "استخدم 4 صوابع لو لسه ما جربتش: بتدي تحكم أكتر في الحركة والتصويب مع بعض.",
      "en": "Try a four-finger claw if you have not: more control of movement and aim together."
    },
    {
      "ar": "قبل ما تتأكد من أي إعداد جديد، ارجع لإعدادك القديم لو الأداء نزل.",
      "en": "If performance drops after a change, go back to your previous setup."
    }
  ],
