    {
      "ar": "الحساسية نقطة بداية مش رقم مضمون. كل إيد وكل موبايل مختلف، فاستخدم المعايرة وتمرين التصويب عشان توصل لرقمك.",
      "en": "Sensitivity is a starting point, not a guaranteed number. Every hand and phone is different, so use calibration and the aim drill to find yours."
    },
    {
      "ar": "على شاشات 120Hz وأعلى بنقلّل الحساسية 6.5% تلقائياً.",
      "en": "On 120Hz+ screens the app lowers sensitivity by 6.5% automatically."
    },
    {
      "ar": "غيّر القيم على خطوات 5 لـ 10 نقاط وجرّب في التدريب بين كل خطوة.",
      "en": "Change values in steps of 5 to 10 points and test in training between steps."
    },
    {
      "ar": "متغيّرش DPI الموبايل إلا لو فاهم تأثيره. مش لازم لتصويب كويس.",
      "en": "Do not change phone DPI unless you understand the effect. It is not needed for good aim."
    },
    {
      "ar": "الموبايلات الضعيفة (2 لـ 3GB): رسومات Smooth وفريمات عالية لو الجهاز مستحمل. لو سخن أو قطّع نزّل الإعدادات. خلّي الجايرو مقفول أول ما تبدأ.",
      "en": "Low-end phones (2 to 3GB): Smooth graphics with high FPS if the phone can take it. Lower settings if it overheats or stutters. Start with gyro off."
    },
    {
      "ar": "لو لسه جديد خلّي Aim Assist شغّال.",
      "en": "If you are new, keep Aim Assist on."
    }
  ],
  "guide": [
    {
      "id": "basics",
      "title": {
        "ar": "الأساسيات",
        "en": "Basics"
      },
      "items": [
        {
          "t": {
            "ar": "اتحرك دايماً",
            "en": "Keep moving"
          },
          "d": {
            "ar": "الواقف بيتضرب بسهولة. اتحرك يمين وشمال بين كل رشقة.",
            "en": "A standing target is easy to hit. Strafe between bursts."
          }
        },
        {
          "t": {
            "ar": "الكروس على الراس",
            "en": "Crosshair at head height"
          },
          "d": {
            "ar": "خلّيه على مستوى الراس وانت بتتحرك، توفّر وقت التصويب.",
            "en": "Keep it at head height while moving to save aiming time."
          }
        },
        {
          "t": {
            "ar": "بيك سريع",
            "en": "Quick peeks"
          },
          "d": {
            "ar": "اطلع من الحافة وارجع بدل ما تقف مكشوف.",
            "en": "Peek from the edge and return instead of standing exposed."
          }
        },
        {
          "t": {
            "ar": "الجلو والعلاج",
            "en": "Gloo and healing"
          },
          "d": {
            "ar": "ارمي الحائط قبل ما تعالج أو تنعش، وعالج وانت مستخبي.",
            "en": "Place the wall before healing or reviving, and heal under cover."
          }
        },
        {
          "t": {
            "ar": "الجايرو مقفول أول",
            "en": "Gyro off at first"
          },
          "d": {
            "ar": "ما تفعّلهوش قبل ما تتعود على الحساسية العادية.",
            "en": "Do not enable it until normal sensitivity feels comfortable."
          }
        },
        {
          "t": {
            "ar": "زر النار",
            "en": "Fire button"
          },
          "d": {
            "ar": "جرّب الحجم المقترح في التطبيق، وزر ثاني على الجنب لو بتلعب بـ3 صوابع.",
            "en": "Try the size suggested in the app, plus a side button if you use three fingers."
          }
        },
        {
          "t": {
            "ar": "ثبّت الأزرار",
            "en": "Fix your layout"
          },
          "d": {
            "ar": "غيّر مكان الأزرار مرة واحدة وسيبه. التغيير كل يوم بيمسح التعوّد.",
            "en": "Set your layout once. Changing it daily erases muscle memory."
          }
        }
      ]
    },
    {
      "id": "weap",
      "title": {
        "ar": "الأسلحة",
        "en": "Weapons"
      },
      "items": [
        {
          "t": {
            "ar": "قريب",
            "en": "Close"
          },
          "d": {
            "ar": "شوتجن للدفعة الواحدة وSMG للتتبع السريع.",
            "en": "Shotgun for one burst, SMG for fast tracking."
          }
        },
        {
          "t": {
            "ar": "متوسط",
            "en": "Mid"
          },
          "d": {
            "ar": "AR هو الأنسب. اسحب خفيف لتحت عشان الارتداد.",
            "en": "AR is the best all-rounder. Pull lightly down for recoil."
          }
        },
        {
          "t": {
            "ar": "بعيد",
            "en": "Far"
          },
          "d": {
            "ar": "اتنفس قبل الضربة وغيّر مكانك بعد كل طلقة.",
            "en": "Settle before the shot and move after each one."
          }
        },
        {
          "t": {
            "ar": "سلاحين بس",
            "en": "Two weapons"
          },
          "d": {
            "ar": "اتدرب على سلاحين بدل ما تبدّل كل مباراة.",
            "en": "Train two weapons instead of switching every match."
          }
        },
        {
          "t": {
            "ar": "الجرانيدات",
            "en": "Grenades"
          },
          "d": {
            "ar": "استخدمها تطلّع العدو من مخبأه مش بس للضرر.",
            "en": "Use them to flush enemies out, not only for damage."
          }
        }
      ]
    },
    {
      "id": "maps",
      "title": {
        "ar": "الخرائط واللوت",
        "en": "Maps and loot"
      },
      "items": [
        {
          "t": {
            "ar": "اختار نزولك",
            "en": "Pick your drop"
          },
          "d": {
            "ar": "الوسط مزدحم والأطراف أهدى. اختار على قد مستواك.",
            "en": "The center is crowded, edges are calmer. Match it to your level."
          }
        },
        {
          "t": {
            "ar": "الأرض العالية",
            "en": "High ground"
          },
          "d": {
            "ar": "بتدي رؤية بس بتكشفك. اتحرك بين الأسطح بحذر.",
            "en": "It gives vision but exposes you. Move between rooftops carefully."
          }
        },
        {
          "t": {
            "ar": "الكباري والمساحات المفتوحة",
            "en": "Bridges and open areas"
          },
          "d": {
            "ar": "أماكن كمين. اعبرها بسرعة ومعاك غطا أو حائط.",
            "en": "Ambush spots. Cross fast with cover or a wall."
          }
        },
        {
          "t": {
            "ar": "خد الأساسيات",
            "en": "Take the essentials"
          },
          "d": {
            "ar": "درع، علاج، ذخيرة، جرانيدات. الباقي حسب المساحة.",
            "en": "Armor, healing, ammo, grenades. The rest depends on space."
          }
        },
        {
          "t": {
            "ar": "صناديق الأعداء",
            "en": "Enemy boxes"
          },
          "d": {
            "ar": "بتجذب الفرق. اتأكد إن محدش قريب قبل ما تقرّب.",
            "en": "They attract squads. Check nobody is near before approaching."
          }
        }
      ]
    },
    {
      "id": "squad",
      "title": {
        "ar": "الفريق والصوت",
        "en": "Squad and audio"
      },
      "items": [
        {
          "t": {
            "ar": "أدوار واضحة",
            "en": "Clear roles"
          },
          "d": {
            "ar": "قائد وقناص ودعم. اللي عارف دوره بيكسب أكتر.",
            "en": "Leader, sniper, support. Knowing your role wins more."
          }
        },
        {
          "t": {
            "ar": "البنج مش الكلام",
            "en": "Ping, don't talk"
          },
          "d": {
            "ar": "البنج للعدو والمكان واللوت. الكلام الكتير بيغطي على الصوت.",
            "en": "Ping enemies, spots and loot. Too much talk hides sounds."
          }
        },
        {
          "t": {
            "ar": "ابقوا قريبين",
            "en": "Stay close"
          },
          "d": {
            "ar": "عشان تنعشوا بعض بسرعة، وركّزوا النار على نفس العدو.",
            "en": "So you can revive fast, and focus fire on one enemy."
          }
        },
        {
          "t": {
            "ar": "سماعة كويسة",
            "en": "Good headphones"
          },
          "d": {
            "ar": "الخطوات واتجاه الطلقات بتتسمع أوضح. أرخص تحسين للمستوى.",
            "en": "Footsteps and shot direction are clearer. The cheapest upgrade."
          }
        },
        {
          "t": {
            "ar": "اسمع قبل ما تدخل",
            "en": "Listen before entering"
          },
          "d": {
            "ar": "وقّف ثانيتين قبل أي مبنى: خطوات، أبواب، إعادة تحميل.",
            "en": "Pause two seconds before a building: steps, doors, reloads."
          }
        }
      ]
    },
    {
      "id": "rank",
      "title": {
        "ar": "الرانكد والتركيز",
        "en": "Ranked and focus"
      },
      "items": [
        {
          "t": {
            "ar": "المركز زي الكيلز",
            "en": "Placement counts"
          },
          "d": {
            "ar": "لعب هادي وصح أحسن من نزول خطر.",
            "en": "Calm, smart play beats risky drops."
          }
        },
        {
          "t": {
            "ar": "الزون بدري",
            "en": "Rotate early"
          },
          "d": {
            "ar": "روح للزون بدري لمكان فيه غطا، متتعلّقش على الحافة.",
            "en": "Rotate early to cover. Don't get stuck on the edge."
          }
        },
        {
          "t": {
            "ar": "غيّر مكانك بعد الكيل",
            "en": "Move after a kill"
          },
          "d": {
            "ar": "متسرقش اللوت وانت مكشوف.",
            "en": "Don't loot in the open."
          }
        },
        {
          "t": {
            "ar": "استراحة كل 45 دقيقة",
            "en": "Break every 45 min"
          },
          "d": {
            "ar": "التعب بيزود الأخطاء. ولو خسرت مرتين بعصبية وقّف شوية.",
            "en": "Fatigue adds mistakes. If you lose twice angry, stop for a bit."
          }
        },
        {
          "t": {
            "ar": "حلل الخسارة",
            "en": "Review losses"
          },
          "d": {
            "ar": "ماتّ إزاي؟ مكشوف؟ مفيش غطا؟ غيّر ده بس.",
            "en": "How did you die: exposed, no cover? Fix just that."
          }
        }
      ]
    }
  ],
